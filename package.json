{
  "name": "@yourbit/company-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "validate": "npm run check && npm run build && node scripts/check-site.mjs",
    "scan:history": "gitleaks git --redact --config .gitleaks.toml .",
    "scan:dist": "gitleaks dir --redact --config .gitleaks.toml dist"
  },
  "dependencies": {
    "astro": "7.3.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "sharp": "0.35.5",
    "typescript": "~7.0.2"
  }
}
