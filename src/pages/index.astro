---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import notibuddyIcon from '../assets/notibuddy-icon.png';
import Arrow from '../components/Arrow.astro';
import { site } from '../config';
const services = [
  { n: '01', title: 'Product engineering', text: 'Turn an idea into software people can use. From the first working version to the details that make it feel finished.', tags: 'Web applications · Full-stack development', icon: 'product' },
  { n: '02', title: 'Architecture & infrastructure', text: 'Give your software room to grow. Thoughtful system design, cloud infrastructure, and a practical path through technical complexity.', tags: 'System design · Cloud infrastructure', icon: 'architecture' },
  { n: '03', title: 'Connected experiences', text: 'Help your tools work together. Connect services, automate the repetitive parts, and bring useful information to the right place.', tags: 'APIs · Integrations · Automation', icon: 'connections' },
];
---
<Base>
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot" />Independent software &amp; engineering</p>
      <h1 id="hero-title">Thoughtful<br />software.<br /><span>Useful by design.</span></h1>
      <p class="hero-description">We build products that make everyday things easier—and help teams turn good ideas into dependable software.</p>
      <div class="hero-actions"><a class="button primary" href="#products">Explore our work <Arrow /></a><a class="button secondary" href="#contact">Build with us</a></div>
      <p class="hero-footnote">Our own products. Your next project. The same care.</p>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="art-grid"></div><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
      <div class="art-coordinate top-coordinate">IDEA → EXPERIENCE</div>
      <div class="pixel-mark"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
      <div class="art-label label-one"><span class="tiny-dot"></span>Made to be useful</div>
      <div class="art-label label-two"><span>01 /</span> The details matter.</div>
      <div class="art-coordinate bottom-coordinate">YOURBIT / BUILT WITH INTENT</div>
    </div>
  </section>
  <div class="intro-strip shell"><p>Good software starts with<br /><strong>a real reason to exist.</strong></p><p>Less friction in your day.<br />More room for what matters.</p><a href="#about" class="text-link">A little about us <Arrow /></a></div>
  <section id="products" class="products shell" aria-labelledby="products-title">
    <div class="section-heading"><div><p class="eyebrow">01 / Our products</p><h2 id="products-title">Small moments.<br />Better experiences.</h2></div><p>Tools we want to use ourselves.<br />Built with care, one detail at a time.</p></div>
    <article class="product-card">
      <div class="product-copy">
        <div class="product-name"><Image src={notibuddyIcon} alt="" width={44} height={44} densities={[1, 2]} format="webp" loading="lazy" /><h3>NotiBuddy</h3><span class="product-category">For iPhone</span></div>
        <h4>Your apps can ask.<br /><span>You can answer.</span></h4>
        <p>Step away from your desk without losing the thread. NotiBuddy brings questions and updates from your AI and connected apps to your iPhone.</p>
        <ul class="product-features"><li><span>↗</span> Reply, choose, and keep things moving</li><li><span>↗</span> Follow progress at a glance</li><li><span>↗</span> Connect your tools through MCP</li></ul>
        <div class="product-actions"><a class="button primary" href={site.notibuddy}>Meet NotiBuddy <Arrow /></a><a class="text-link" href={site.notibuddySource}>Explore the MCP package <span aria-hidden="true">↗</span></a></div>
        <p class="availability">iOS app in development · MCP package available</p>
      </div>
      <figure class="product-visual">
        <div class="phone-frame"><img src="/images/notibuddy-question.webp" alt="NotiBuddy on an iPhone lock screen, showing a trip-planning question with Mountains and The coast choices, plus a notification asking for a nightly budget." width="1206" height="2622" loading="lazy" decoding="async" /></div>
        <figcaption><span class="tiny-dot"></span>A little nudge. A useful answer.</figcaption>
      </figure>
    </article>
  </section>
  <section id="services" class="services shell" aria-labelledby="services-title">
    <div class="section-heading"><div><p class="eyebrow">02 / Work with us</p><h2 id="services-title">Your idea.<br />Our engineering.</h2></div><p>Starting something new or making an existing system better? We help with both.</p></div>
    <div class="service-grid">{services.map(service => <article class="service-card">
      <div class="service-top"><span>{service.n}</span><svg viewBox="0 0 40 40" fill="none" aria-hidden="true">{service.icon === 'product' ? <><rect x="7" y="8" width="26" height="24" rx="4" /><path d="M7 16h26m-18 8h10" /></> : service.icon === 'architecture' ? <><path d="m20 5 15 8-15 8-15-8 15-8Zm-15 16 15 8 15-8M5 29l15 8 15-8" /></> : <><rect x="3" y="4" width="12" height="12" rx="3" /><rect x="25" y="24" width="12" height="12" rx="3" /><path d="M15 10h9a7 7 0 0 1 7 7v7M9 16v8a6 6 0 0 0 6 6h10" /></>}</svg></div>
      <h3>{service.title}</h3><p>{service.text}</p><div class="service-tags">{service.tags}</div>
    </article>)}</div>
    <div class="services-bottom"><p>A practical partner, from the first conversation to the last detail.</p><a class="text-link" href="#contact">Tell us what you’re working on <Arrow /></a></div>
  </section>
  <section id="about" class="about shell" aria-labelledby="about-title">
    <div class="about-copy"><p class="eyebrow">03 / A little about Yourbit</p><h2 id="about-title">Care in the code.<br />Clarity in the experience.</h2><p>Yourbit, LLC is an independent software engineering company. We build our own products and work with teams on theirs.</p><p>Our approach is pragmatic: understand the problem, choose the right tools, and pay attention to how the result feels to use. We believe the best software earns its place in your day.</p><a class="text-link" href={site.github}>See what we’re building on GitHub <Arrow /></a></div>
    <div class="principles"><article><span>01</span><div><h3>Start with useful.</h3><p>A clear purpose comes before a long feature list.</p></div></article><article><span>02</span><div><h3>Respect the person.</h3><p>Consider people’s time, attention, and privacy in every decision.</p></div></article><article><span>03</span><div><h3>Build for what’s next.</h3><p>Keep things understandable, maintainable, and ready to evolve.</p></div></article></div>
  </section>
  <section id="contact" class="contact shell" aria-labelledby="contact-title"><div class="contact-glow" aria-hidden="true"></div><div><p class="eyebrow">Let’s make something useful</p><h2 id="contact-title">What are you<br />working on?</h2><p>Have a project in mind, a question about our work,<br class="desktop-break" /> or just a good idea? We’d like to hear it.</p></div><div class="contact-actions"><a class="button primary" href={`mailto:${site.email}`}>Start a conversation <Arrow /></a><a class="email-link" href={`mailto:${site.email}`}>{site.email}</a><span>A person on the other end.</span></div></section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1.25fr 1fr; gap: 20px; align-items: center; padding-top: 94px; padding-bottom: 94px; }
  .hero .eyebrow { display: flex; align-items: center; gap: 9px; }
  .status-dot, .tiny-dot { display: inline-block; width: 6px; height: 6px; background: var(--accent-cyan); border-radius: 100%; box-shadow: 0 0 14px #38bdf84d; flex-shrink: 0; }
  h1 { font-size: clamp(52px, 5.7vw, 78px); line-height: 1.06; letter-spacing: -.065em; font-weight: 650; margin-top: 27px; }
  h1 > span { color: #7dd3fc; }
  .hero-description { font-size: 17px; line-height: 1.8; color: var(--text-secondary); max-width: 450px; margin-top: 28px; }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 30px; }
  .hero-footnote { font-size: 11px; color: var(--text-tertiary); margin-top: 22px; }
  .hero-art { height: 470px; position: relative; overflow: hidden; mask-image: linear-gradient(transparent, #000 10%, #000 90%, transparent); }
  .art-grid { position: absolute; inset: 0; background-image: linear-gradient(#8abbe709 1px, transparent 1px), linear-gradient(90deg, #8abbe709 1px, transparent 1px); background-size: 42px 42px; mask-image: radial-gradient(ellipse, #000 35%, transparent 75%); }
  .orbit { position: absolute; border: 1px solid #6883c322; border-radius: 50%; left: 50%; top: 50%; transform: translate(-50%, -50%) rotate(-30deg); }
  .orbit-one { width: 430px; height: 280px; }
  .orbit-two { width: 300px; height: 430px; transform: translate(-50%, -50%) rotate(-40deg); border-style: dashed; }
  .pixel-mark { position: absolute; width: 242px; height: 300px; top: 84px; left: calc(50% - 121px); display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(4, 1fr); gap: 7px; transform: perspective(700px) rotateY(-18deg) rotateX(15deg) rotateZ(-9deg); filter: drop-shadow(0 24px 35px #17659844); }
  .pixel-mark i { display: block; border: 1px solid #9ce3ff85; border-radius: 13px; background: linear-gradient(145deg,#70cefa,#2587b9 55%,#286ba7); box-shadow: inset 1px 2px 0 #b2ebff66, 8px 8px 0 #153953; }
  .pixel-mark i:nth-child(1) { grid-area: 1 / 1; opacity: .85; }
  .pixel-mark i:nth-child(2) { grid-area: 1 / 3; }
  .pixel-mark i:nth-child(3) { grid-area: 2 / 1; opacity: .65; }
  .pixel-mark i:nth-child(4) { grid-area: 2 / 3; opacity: .95; }
  .pixel-mark i:nth-child(5) { grid-area: 3 / 2; }
  .pixel-mark i:nth-child(6) { grid-area: 4 / 2; opacity: .7; }
  .pixel-mark i:nth-child(7) { grid-area: 4 / 3; opacity: .08; transform: translate(35px,20px); }
  .art-coordinate { position: absolute; font: 9px var(--font-mono); letter-spacing: .16em; color: #a8b5c899; }
  .top-coordinate { left: 18px; top: 40px; }.bottom-coordinate { right: 18px; bottom: 29px; }
  .art-label { display: flex; align-items: center; gap: 11px; position: absolute; background: #0d1521ee; border: 1px solid #9fbee326; border-radius: 10px; padding: 15px 18px; font-size: 11px; box-shadow: 0 14px 30px #0003; }
  .label-one { right: 0; top: 90px; }.label-two { left: 5px; bottom: 72px; }.label-two span { color: var(--accent-cyan); font-family: var(--font-mono); }
  .intro-strip { border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle); padding-block: 30px; display: grid; grid-template-columns: 1.2fr 1fr auto; align-items: center; gap: 30px; }
  .intro-strip p { font-size: 13px; line-height: 1.7; color: var(--text-secondary); }.intro-strip strong { color: var(--text-primary); font-weight: 500; }
  .products, .services { padding-top: 106px; }
  .section-heading { display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; margin-bottom: 38px; }
  h2 { font-size: clamp(34px, 4vw, 48px); font-weight: 570; line-height: 1.13; letter-spacing: -.045em; margin-top: 17px; }
  .section-heading > p { max-width: 320px; font-size: 14px; line-height: 1.8; color: var(--text-secondary); padding-bottom: 5px; }
  .product-card { display: grid; grid-template-columns: 1.2fr 1fr; background: linear-gradient(120deg,#111927,#0c111d 60%,#111b35); border: 1px solid #a3c4ed24; border-radius: 24px; overflow: hidden; }
  .product-copy { padding: 52px 0 48px 48px; }.product-name { display: flex; align-items: center; gap: 12px; }.product-name img { border-radius: 11px; }.product-name h3 { font-size: 23px; letter-spacing: -.04em; }
  .product-category { color: var(--text-secondary); font-size: 10px; border: 1px solid var(--border-medium); border-radius: 999px; padding: 6px 10px; margin-left: 4px; }
  h4 { font-size: clamp(30px, 3.5vw, 42px); font-weight: 550; line-height: 1.16; letter-spacing: -.045em; margin-top: 37px; }h4 span { color: #7dd3fc; }
  .product-copy > p { color: var(--text-secondary); font-size: 14px; line-height: 1.85; max-width: 375px; margin-top: 22px; }
  .product-features { list-style: none; margin-top: 24px; display: grid; gap: 13px; font-size: 12px; color: #c3cedd; }.product-features span { color: var(--accent-cyan); margin-right: 8px; }
  .product-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin-top: 30px; }.product-actions .text-link { font-size: 12px; gap: 8px; }
  .product-copy > .availability { font-size: 10px; color: var(--text-tertiary); margin-top: 18px; }
  .product-visual { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 36px 25px 25px; background: radial-gradient(ellipse at 50% 55%,#3289cb25,transparent 68%); }
  .phone-frame { width: 222px; border: 5px solid #192431; border-radius: 37px; box-shadow: 0 0 0 1px #7099bf55, 0 28px 60px #0007; overflow: hidden; transform: rotate(5deg); }.phone-frame img { display: block; width: 100%; height: auto; }
  figcaption { display: flex; align-items: center; gap: 8px; margin-top: 24px; font-size: 10px; color: var(--text-secondary); }
  .service-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 18px; }.service-card { border: 1px solid var(--border-subtle); background: #10172399; border-radius: 18px; padding: 28px; display: flex; flex-direction: column; }
  .service-top { display: flex; justify-content: space-between; align-items: center; color: var(--text-tertiary); font: 11px var(--font-mono); margin-bottom: 28px; }.service-top svg { width: 32px; height: 32px; stroke: #76cafa; stroke-width: 1.5px; }
  .service-card h3 { font-size: 21px; font-weight: 550; line-height: 1.3; letter-spacing: -.025em; margin-bottom: 14px; }.service-card p { font-size: 13px; color: var(--text-secondary); line-height: 1.8; flex: 1; }
  .service-tags { font-size: 10px; line-height: 1.7; color: var(--text-tertiary); border-top: 1px solid var(--border-subtle); margin-top: 28px; padding-top: 17px; }
  .services-bottom { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-top: 25px; }.services-bottom p { color: var(--text-tertiary); font-size: 12px; }.services-bottom .text-link { font-size: 12px; }
  .about { display: grid; grid-template-columns: 1.1fr 1fr; gap: 110px; padding-block: 120px; margin-top: 100px; border-top: 1px solid var(--border-subtle); }
  .about-copy > p:not(.eyebrow) { color: var(--text-secondary); font-size: 14px; line-height: 1.85; margin-top: 24px; max-width: 450px; }.about-copy .text-link { margin-top: 28px; font-size: 12px; }
  .principles { display: flex; flex-direction: column; justify-content: center; }.principles article { display: flex; gap: 24px; padding-block: 27px; border-bottom: 1px solid var(--border-subtle); }.principles article:first-child { border-top: 1px solid var(--border-subtle); }
  .principles article > span { color: var(--accent-cyan); font: 11px var(--font-mono); padding-top: 4px; }.principles h3 { font-size: 19px; font-weight: 550; margin-bottom: 9px; letter-spacing: -.02em; }.principles p { color: var(--text-secondary); font-size: 13px; line-height: 1.8; }
  .contact { position: relative; overflow: hidden; display: flex; justify-content: space-between; align-items: center; gap: 40px; border: 1px solid #6189ad38; border-radius: 24px; padding: 58px; background: linear-gradient(110deg,#101a27,#101426); margin-bottom: 40px; }.contact > div:not(.contact-glow) { z-index: 1; }
  .contact-glow { position: absolute; right: -100px; top: -150px; width: 500px; height: 500px; border-radius: 100%; background: radial-gradient(#27779423, transparent 65%); pointer-events: none; }
  .contact h2 { font-size: clamp(36px,4.5vw,54px); }.contact p:not(.eyebrow) { margin-top: 22px; color: var(--text-secondary); font-size: 14px; line-height: 1.8; }
  .contact-actions { display: flex; flex-direction: column; align-items: center; gap: 18px; }.email-link { font-size: 13px; color: var(--text-secondary); text-underline-offset: 4px; }.email-link:hover { text-decoration: underline; }.contact-actions > span { font-size: 10px; color: var(--text-tertiary); }
  @media (max-width: 1000px) {
    .hero { grid-template-columns: 1.2fr 1fr; padding-top: 70px; }.hero-art { height: 400px; }.pixel-mark { width: 195px; height: 250px; left: calc(50% - 98px); top: 75px; }.label-one { top: 35px; }.label-two { bottom: 34px; }.top-coordinate, .bottom-coordinate { display: none; }
    .product-copy { padding: 34px 0 34px 30px; }.service-card { padding: 22px; }.service-card h3 { font-size: 19px; }.about { gap: 55px; }.contact { padding: 40px; }
  }
  @media (max-width: 700px) {
    .hero { grid-template-columns: 1fr; gap: 12px; padding-top: 50px; padding-bottom: 35px; }h1 { font-size: clamp(46px, 9.6vw, 66px); margin-top: 23px; }.hero-description { font-size: 15px; margin-top: 23px; }.hero .eyebrow { font-size: 9px; letter-spacing: .12em; }.hero-footnote { font-size: 10px; }
    .hero-art { height: 300px; max-width: 420px; width: 100%; justify-self: center; }.pixel-mark { width: 154px; height: 200px; top: 49px; left: calc(50% - 77px); gap: 5px; }.pixel-mark i { border-radius: 8px; box-shadow: inset 1px 2px 0 #b2ebff66, 5px 5px 0 #153953; }.orbit-one { width: 320px; height: 190px; }.orbit-two { width: 215px; height: 300px; }.art-label { padding: 11px 12px; font-size: 9px; }.label-one { top: 38px; }.label-two { bottom: 35px; }
    .intro-strip { grid-template-columns: 1fr 1fr; gap: 22px; padding-block: 25px; }.intro-strip p { font-size: 11px; }.intro-strip .text-link { grid-column: 1 / -1; font-size: 12px; }
    .products,.services { padding-top: 70px; }.section-heading { display: block; margin-bottom: 28px; }.section-heading > p { margin-top: 22px; font-size: 13px; }
    .product-card { grid-template-columns: 1fr; }.product-copy { padding: 28px; }.product-name h3 { font-size: 22px; }.product-category { font-size: 9px; padding-inline: 8px; }.product-name { gap: 9px; }.product-name img { width: 36px; height: 36px; }h4 { margin-top: 28px; font-size: 34px; }.product-copy > p { font-size: 13px; }
    .product-visual { padding: 0 24px 32px; }.phone-frame { width: 205px; }.service-grid { grid-template-columns: 1fr; gap: 14px; }.service-card { padding: 25px; }.service-top { margin-bottom: 20px; }.service-card h3 { font-size: 22px; }.service-tags { margin-top: 23px; }
    .services-bottom { display: block; }.services-bottom p { line-height: 1.8; }.services-bottom .text-link { margin-top: 15px; }.about { grid-template-columns: 1fr; gap: 35px; margin-top: 70px; padding-block: 65px; }.principles article { padding-block: 23px; }
    .contact { display: block; padding: 28px; margin-bottom: 20px; }.contact-actions { align-items: flex-start; margin-top: 30px; }.contact .eyebrow { font-size: 10px; }.desktop-break { display: none; }
  }
  @media (max-width: 370px) { .hero-actions .button { padding-inline: 17px; font-size: 12px; gap: 10px; }.product-copy { padding: 23px; }.product-category { display: none; }h4 { font-size: 30px; } }
</style>
