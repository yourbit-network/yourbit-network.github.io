---
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../config';
interface Props { title?: string; description?: string; noindex?: boolean; }
const {
  title = 'Yourbit — Thoughtful software. Useful by design.',
  description = 'Yourbit builds useful software and helps teams bring ideas to life. Meet NotiBuddy and explore our product engineering and consulting services.',
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, ''), site.origin).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'self'; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#07090e" />
    <meta name="facebook-domain-verification" content="uu4pxm397xbkjkox4haac5tvvbwzzg" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="describedby" href="/llms.txt" type="text/plain" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Yourbit" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.origin}/og-image.png`} />
    <meta property="og:image:alt" content="Yourbit — Thoughtful software. Useful by design." />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <div class="shell nav-wrap">
        <a class="wordmark" href="/" aria-label="Yourbit home"><Mark /><span>yourbit<span class="brand-dot">.</span></span></a>
        <nav aria-label="Main navigation">
          <a href="/#products">Products</a><a href="/#services">Services</a><a href="/#about">About</a>
        </nav>
        <a class="nav-contact" href="/#contact">Let’s talk <Arrow /></a>
      </div>
    </header>
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer class="site-footer shell">
      <div class="footer-top">
        <div><a class="wordmark" href="/" aria-label="Yourbit home"><Mark /><span>yourbit<span class="brand-dot">.</span></span></a><p>Thoughtful software.<br />Useful by design.</p></div>
        <nav aria-label="Explore"><span class="footer-label">Explore</span><a href="/#products">Our products</a><a href="/#services">Work with us</a><a href={site.github}>GitHub <span aria-hidden="true">↗</span></a></nav>
        <nav aria-label="Company"><span class="footer-label">Company</span><a href="/#about">About Yourbit</a><a href="/#contact">Contact</a><a href="/privacy">Website privacy</a><a href="/tos">Website terms</a><a href="/llms.txt">For AI assistants</a></nav>
      </div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} {site.company}</span><span>Small details. Lasting usefulness.</span></div>
    </footer>
  </body>
</html>
